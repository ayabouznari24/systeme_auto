// Prisma schema for the Mail Intelligence system.
// Modeled so a single logical "email" always has an optional 1:1 AI analysis
// attached once processing completes, and so mailbox connections are
// provider-agnostic (Titan today, Gmail/Outlook/Yahoo/Proton later).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  emailAccounts EmailAccount[]
  notificationSettings NotificationSettings?

  @@map("users")
}

// ---------------------------------------------------------------------------
// Mailbox connections (provider-agnostic)
// ---------------------------------------------------------------------------

enum MailProvider {
  TITAN
  IMAP_GENERIC
  GMAIL
  OUTLOOK
  OFFICE365
  YAHOO
  PROTON
}

model EmailAccount {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  provider    MailProvider @default(TITAN)
  label       String       @default("Titan Mail")
  emailAddress String

  // IMAP connection settings. Password/tokens are stored encrypted at rest
  // (see lib/crypto.ts) - never stored in plaintext.
  imapHost    String?
  imapPort    Int?          @default(993)
  imapSecure  Boolean       @default(true)
  username    String?
  encryptedSecret String?   // encrypted password or OAuth refresh token

  isActive    Boolean       @default(true)
  lastSyncAt  DateTime?
  lastSeenUid Int?          @default(0)
  syncCursor  String?       // provider-specific cursor (e.g. IMAP UIDVALIDITY:UID or historyId)

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  emails      Email[]

  @@index([userId])
  @@map("email_accounts")
}

// ---------------------------------------------------------------------------
// Emails + AI analysis
// ---------------------------------------------------------------------------

enum EmailCategory {
  URGENT
  IMPORTANT
  TODAY
  THIS_WEEK
  INFORMATION
  NEWSLETTER
  SPAM
}

enum Sentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
}

enum RecommendedAction {
  REPLY
  CREATE_TASK
  ARCHIVE
  FORWARD
  DELETE
}

enum ProcessingStatus {
  PENDING
  ANALYZING
  DONE
  FAILED
}

model Email {
  id              String        @id @default(cuid())
  emailAccountId  String
  emailAccount    EmailAccount  @relation(fields: [emailAccountId], references: [id], onDelete: Cascade)

  // Provider-native identifiers, used for de-duplication.
  messageId       String        // RFC 822 Message-ID
  uid             Int?
  folder          String        @default("INBOX")

  fromName        String?
  fromAddress     String
  toAddresses     String[]      @default([])
  subject         String
  bodyText        String?
  bodyHtml        String?
  snippet         String?
  receivedAt      DateTime
  hasAttachments  Boolean       @default(false)

  // --- AI analysis (embedded 1:1; kept on the row for fast list/sort queries) ---
  status          ProcessingStatus @default(PENDING)
  category        EmailCategory?
  priorityScore   Int?           // 1-100
  sentiment       Sentiment?
  summary         String?        // AI generated 3-line summary
  keywords        String[]       @default([])
  recommendedAction RecommendedAction?
  hasDeadline     Boolean        @default(false)
  deadlineAt      DateTime?
  amountsDetected String[]       @default([])
  isFromRecruiter Boolean        @default(false)
  isFromClient    Boolean        @default(false)
  isJobApplication Boolean       @default(false)
  aiModel         String?
  aiRawResponse   Json?
  analysisError   String?
  analyzedAt      DateTime?

  // --- user actions ---
  isRead          Boolean       @default(false)
  isProcessed     Boolean       @default(false)
  processedAt     DateTime?
  isArchived      Boolean       @default(false)
  isDeleted       Boolean       @default(false)

  tags            EmailTag[]

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([emailAccountId, messageId])
  @@index([emailAccountId, receivedAt])
  @@index([category])
  @@index([priorityScore])
  @@index([status])
  @@index([fromAddress])
  @@map("emails")
}

model Tag {
  id        String     @id @default(cuid())
  name      String     @unique
  color     String?    @default("#64748b")
  createdAt DateTime   @default(now())

  emails    EmailTag[]

  @@map("tags")
}

model EmailTag {
  emailId   String
  email     Email    @relation(fields: [emailId], references: [id], onDelete: Cascade)
  tagId     String
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([emailId, tagId])
  @@map("email_tags")
}

// ---------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------

model NotificationSettings {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  desktopEnabled    Boolean  @default(true)
  emailEnabled      Boolean  @default(false)
  notifyEmailTo     String?
  minPriorityScore  Int      @default(80)
  categories        EmailCategory[] @default([URGENT, IMPORTANT])

  updatedAt         DateTime @updatedAt

  @@map("notification_settings")
}

// ---------------------------------------------------------------------------
// Sync run history (observability for the cron job)
// ---------------------------------------------------------------------------

model SyncRun {
  id              String   @id @default(cuid())
  emailAccountId  String?
  startedAt       DateTime @default(now())
  finishedAt      DateTime?
  fetchedCount    Int      @default(0)
  newCount        Int      @default(0)
  analyzedCount   Int      @default(0)
  failedCount     Int      @default(0)
  status          String   @default("RUNNING") // RUNNING | SUCCESS | FAILED
  error           String?

  @@map("sync_runs")
}
