# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
POSTGRES_USER=mailintel
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mailintel
# Use "postgres" as the host when running via docker-compose, "localhost" for local dev.
DATABASE_URL="postgresql://mailintel:change-me@localhost:5432/mailintel?schema=public"

# ---------------------------------------------------------------------------
# NextAuth
# ---------------------------------------------------------------------------
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me"

# ---------------------------------------------------------------------------
# Secret encryption (IMAP passwords are encrypted at rest with this key)
# Generate with: openssl rand -hex 32
# ---------------------------------------------------------------------------
ENCRYPTION_KEY="change-me-64-hex-chars"

# ---------------------------------------------------------------------------
# Seed user (created by `npm run db:seed`)
# ---------------------------------------------------------------------------
SEED_USER_EMAIL="you@example.com"
SEED_USER_PASSWORD="change-me"

# ---------------------------------------------------------------------------
# AI provider - swap between OpenAI and Claude without touching any code
# ---------------------------------------------------------------------------
AI_PROVIDER=openai
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-4o-mini"

# AI_PROVIDER=claude
# ANTHROPIC_API_KEY="sk-ant-..."
# ANTHROPIC_MODEL="claude-sonnet-5"

# ---------------------------------------------------------------------------
# Titan Email (IMAP) - added via the Settings page in the dashboard, but the
# cron process needs at least one EmailAccount row to exist in the database.
# Titan's IMAP host is fixed to imap.titan.email:993 (see services/email/titan-provider.ts).
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Cron
# ---------------------------------------------------------------------------
# Every 5 minutes by default. Standard cron syntax.
SYNC_CRON_SCHEDULE="*/5 * * * *"

# ---------------------------------------------------------------------------
# Email notifications (SMTP) - optional
# ---------------------------------------------------------------------------
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Mail Intelligence <notifications@example.com>"
